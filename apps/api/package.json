{
  "name": "@lintel/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS HTTP API: thin controllers over the application use cases.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests src",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@lintel/api-contracts": "workspace:*",
    "@lintel/application": "workspace:*",
    "@lintel/configuration": "workspace:*",
    "@lintel/database": "workspace:*",
    "@lintel/domain": "workspace:*",
    "@lintel/integrations": "workspace:*",
    "@lintel/shared": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@ts-rest/core": "catalog:",
    "@ts-rest/nest": "catalog:",
    "@ts-rest/open-api": "catalog:",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lintel/tsconfig": "workspace:*",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
