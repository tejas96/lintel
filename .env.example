# Lintel — environment variables.
# Copy to .env for local development. Every value below works with
# `pnpm infra:up`. Production rules are enforced at startup (docs/SECURITY.md).

NODE_ENV=development
LOG_LEVEL=info
WEB_BASE_URL=http://localhost:3100
API_BASE_URL=http://localhost:4100
API_PORT=4100
BUSINESS_TIMEZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:8081
TRUST_PROXY=false
# COOKIE_SECURE=true            # defaults to true when NODE_ENV=production

DATABASE_URL=postgres://lintel:lintel-local-only@127.0.0.1:5450/lintel
# At least 32 random characters in production: openssl rand -base64 48
SESSION_SECRET=local-development-secret-change-me-0000000000

# Sign-in codes. "local" writes the code to the API log (development only).
OTP_PROVIDER=local
# Development only: every code is this value. Rejected in production.
OTP_DEVELOPMENT_CODE=123456
# MSG91 (required when OTP_PROVIDER=msg91) — see docs/INTEGRATIONS.md
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_BASE_URL=https://control.msg91.com
# MSG91_TIMEOUT_MS=8000

# RustFS object storage (S3 API)
STORAGE_ENDPOINT=http://127.0.0.1:9110
STORAGE_REGION=us-east-1
STORAGE_BUCKET=lintel-files
STORAGE_ACCESS_KEY=lintel-local
STORAGE_SECRET_KEY=lintel-local-secret
STORAGE_AUTO_CREATE_BUCKET=true
UPLOAD_MAX_BYTES=26214400

# Temporal
TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=127.0.0.1:7240
TEMPORAL_NAMESPACE=lintel
TEMPORAL_TASK_QUEUE=lintel-main

# Push notifications. "log" records intended pushes without sending them.
PUSH_PROVIDER=log
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Notification SMS (urgent alerts only, generic text + link). "log" records in the worker log.
SMS_NOTIFICATIONS_ENABLED=false
SMS_PROVIDER=log
# Required with SMS_PROVIDER=msg91 (uses MSG91_AUTH_KEY above) — see docs/INTEGRATIONS.md
# MSG91_SMS_TEMPLATE_ID=
# MSG91_SMS_DLT_TEMPLATE_ID=

# Notification email (per kind, immediately or in a daily digest). "log" writes to the worker log.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=log
# Daily digest time, business timezone
EMAIL_DIGEST_TIME=18:00
# Required with EMAIL_PROVIDER=smtp. Port 465 implies TLS; otherwise STARTTLS is required.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Lintel <notifications@studio.example.com>"
# SMTP_TIMEOUT_MS=15000

# Web push for the web app (public Firebase web config, read at web build time).
# Leave empty to hide web push. Values: Firebase console → Project settings.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Phase 2 only. Startup refuses AI_FEATURES_ENABLED=true in Phase 1.
AI_FEATURES_ENABLED=false

# ---- Production compose only (infrastructure/docker/compose.production.yaml) ----
# POSTGRES_USER=lintel
# POSTGRES_PASSWORD=
# POSTGRES_DB=lintel
# LINTEL_DOMAIN=studio.example.com
